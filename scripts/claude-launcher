#!/bin/bash
# Resolve the installed executable without editing global mise config at launch.
# mise exec's PATH may select this wrapper, so exclude it explicitly.
usable() { [[ -x "$1" && ! "$1" -ef "$0" ]]; }
claude_executable=$(mise which claude 2>/dev/null)
if ! usable "$claude_executable"; then
  claude_executable=
  while IFS= read -r candidate; do
    if usable "$candidate"; then claude_executable=$candidate; break; fi
  done < <(type -ap claude)
fi
if [[ -z "$claude_executable" ]]; then
  printf '%s\n' 'Could not resolve an installed Claude executable; install it with: mise use -g claude' >&2
  exit 1
fi
exec "$claude_executable" "$@"
